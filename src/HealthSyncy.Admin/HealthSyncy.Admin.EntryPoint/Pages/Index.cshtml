@page
@model IndexModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Activity · HealthSyncy</title>
    <link rel="stylesheet" href="/admin.css">
</head>
<body>
    <header>
        <strong>HealthSyncy</strong>
        <span>Admin</span>
    </header>
    <main>
        <h1>Activity</h1>
        <section aria-label="Sync status">
            <p class="status">@Model.Status</p>
            <p>@Model.Zone · Captured @IndexModel.Display(Model.Today?.CapturedAtUtc) · Received @IndexModel.Display(Model.Today?.ReceivedAtUtc)</p>
        </section>
        <div class="metrics">
            @foreach (var metric in Model.Metrics)
            {
                <article>
                    <span>@metric.Label</span>
                    <strong>@IndexModel.Display(metric.Value)</strong>
                    <small>@metric.Unit</small>
                </article>
            }
        </div>
        <h2>Last seven days</h2>
        <div class="scroll">
            <table>
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Steps</th>
                        <th>Move · kcal</th>
                        <th>Exercise · min</th>
                        <th>Stand · hr</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Days.Reverse())
                    {
                        <tr>
                            <td>@row.Day</td>
                            <td>@IndexModel.Display(row.Snapshot?.Totals.Steps)</td>
                            <td>@IndexModel.Display(row.Snapshot?.Totals.ActiveKcal)</td>
                            <td>@IndexModel.Display(row.Snapshot?.Totals.ExerciseMinutes)</td>
                            <td>@IndexModel.Display(row.Snapshot?.Totals.StandHours)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <h2>Sync settings</h2>
        <form method="post">
            <div asp-validation-summary="All"></div>
            <label><input asp-for="Enabled"> Accept uploads</label>
            <label>Alert after <input asp-for="StaleAfterMinutes" min="15" max="1440"> minutes without a fresh snapshot</label>
            <button>Save settings</button>
        </form>
    </main>
</body>
</html>
