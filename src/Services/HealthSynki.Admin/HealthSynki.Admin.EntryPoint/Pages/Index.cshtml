@page
@model HealthSynki.Admin.Pages.IndexModel
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Activity · HealthSynki</title><link rel="stylesheet" href="/admin.css"></head>
<body><header><strong>HealthSynki</strong><span>Admin</span></header><main>
<h1>Activity</h1><section aria-label="Sync status"><p class="status">@Model.Status</p>
<p>@Model.Zone · Captured @(Model.Today?.CapturedAtUtc.ToString("u") ?? "—") · Received @(Model.Today?.ReceivedAtUtc.ToString("u") ?? "—")</p></section>
<div class="metrics">
@foreach (var item in new (string Label, decimal? Value, string Unit)[]{
    ("Steps",Model.Today?.Totals.Steps,"steps"),("Move",Model.Today?.Totals.ActiveKcal,"kcal"),
    ("Exercise",Model.Today?.Totals.ExerciseMinutes,"min"),("Stand",Model.Today?.Totals.StandHours,"hr"),
    ("Resting energy",Model.Today?.Totals.RestingKcal,"kcal")}) {
<article><span>@item.Label</span><strong>@Model.Display(item.Value)</strong><small>@item.Unit</small></article> }
</div><h2>Last seven days</h2><div class="scroll"><table><thead><tr><th>Date</th><th>Steps</th><th>Move · kcal</th><th>Exercise · min</th><th>Stand · hr</th></tr></thead>
<tbody>@foreach(var row in Model.Days.Reverse()) {
<tr><td>@row.Day</td><td>@Model.Display(row.Snapshot?.Totals.Steps)</td><td>@Model.Display(row.Snapshot?.Totals.ActiveKcal)</td>
<td>@Model.Display(row.Snapshot?.Totals.ExerciseMinutes)</td><td>@Model.Display(row.Snapshot?.Totals.StandHours)</td></tr> }</tbody>
</table></div><h2>Sync settings</h2><form method="post"><div asp-validation-summary="All"></div>
<label><input asp-for="Enabled"> Accept uploads</label>
<label>Alert after <input asp-for="StaleAfterMinutes" min="15" max="1440"> minutes without a fresh snapshot</label>
<button>Save settings</button></form></main></body></html>
